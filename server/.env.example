PET_DOMAIN=pets.example.com

# Economy (testnet first). Production FRENS: 0x1A96226727a1D0a46334b3A4b3878B32B7659ba3 on Base — see contracts/config/economy.json
# ECONOMY_MODE=testnet
# FRENS_TOKEN=0xDeployTestFRENSOnBaseSepoliaFirst
# CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# ECONOMY_DEPOSITS=false
# UUPS proxies from contracts/testnet/script/DeployEconomy.s.sol
# TREASURY_PROXY=0x...
# JACKPOT_VAULT_PROXY=0x...
# GAME_CONTROLLER=0x...
# DepositRouter proxy + DepositSession clones (also emitted by DeployEconomy.s.sol)
# DEPOSIT_ROUTER_PROXY=0x...
# Controller key that signs DepositRouter.createSession (same wallet used for DeployEconomy on testnet).
# When set (with DEPOSIT_ROUTER_PROXY + BASE_RPC_URL) the server auto-provisions a fresh clone per deposit.
# GAME_CONTROLLER_PRIVATE_KEY=0x...
# Comma-separated deposit-session addresses handed out to users (fallback when no live router; open = no active session)
# DEPOSIT_SESSION_ADDRESSES=0x...,0x...
# Shared secret the deposit indexer sends as X-Indexer-Secret to POST /api/deposits/confirm
# ECONOMY_INDEXER_SECRET=change-me
# On-chain deposit indexer (background task that scans Deposit logs and credits the ledger).
# auto = start whenever an allocator + BASE_RPC_URL are wired; true forces it; false disables.
# INDEXER_ENABLED=auto
# INDEXER_POLL_SECONDS=6
# INDEXER_LOOKBACK=300  # blocks behind head to re-scan on a cold start

# TinyFrens NFT collection (contracts/TinyFrensNFT.sol). 100% on-chain art; address comes from
# contracts/testnet/script/DeployTinyFrensNFT.s.sol. When set (with BASE_RPC_URL) this enables
# GET /api/nft/uri?tokenId=N (on-chain tokenURI) and the web/gallery.html viewer.
# TINYFRENS_NFT_ADDRESS=0x...

# Farcaster Mini App & Neynar Bot Agent
# NEYNAR_API_KEY=your_neynar_api_key
# NEYNAR_CLIENT_ID=your_neynar_client_id
# FARCASTER_SIGNER_UUID=your_approved_signer_uuid
# SNAPCHAIN_API_URL=https://snapchain-api.neynar.com
# NEYNAR_WEBHOOK_URL=https://api.neynar.com/f/app/<client-id>/event

# Telegram Mini App & Bot (see TELEGRAM-DISCORD.md)
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather
# TELEGRAM_MINIAPP_URL=https://tinyfrens.lol/web/
# After deploy, register the webhook once:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-server>/api/telegram/webhook
# Set a random secret in both the webhook call (secret_token) and this environment.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_MINIAPP_DEEP_LINK=https://t.me/TinyFrensBot?startapp=home

# "open an issue" in a Telegram chat -> a real GitHub issue summarising the recent
# conversation. Needs an AI key (GEMINI_API_KEY above) to draft it.
# Token with Issues: read and write on the target repo (a GitHub App installation
# works the same way). A fine-grained personal access token requires an expiration date
# (max 1 year) - diarise renewing it.
# GITHUB_TOKEN=github_pat_your-fine-grained-token
# GITHUB_REPO=dutchiono/TinyFrens
# TinyFrensAdmin GitHub App: App ID 5306266, Client ID Iv23liw61GPxfkuofyiv.
# Preferred alternative to a static GITHUB_TOKEN: installation tokens renew automatically.
# GITHUB_APP_ID=5306266
# GITHUB_APP_PRIVATE_KEY_PATH=/home/miono/tinyfrens-server/.secrets/tinyfrensadmin.pem
# Optional; if omitted, the installation is discovered for GITHUB_REPO.
# GITHUB_APP_INSTALLATION_ID=
# Optional: comma-separated labels added to every bot issue. Only labels that already
# exist in the repo are applied (GitHub 422s an unknown label), so create them first.
# GITHUB_ISSUE_LABELS=telegram,bot
# Optional: how many buffered chat messages to summarise (1-200, default 25).
# The Bot API cannot read past history, so this is what the relay has seen since it
# started — keep it on one instance.
# TELEGRAM_ISSUE_HISTORY=25

# Optional inbound webhook (GitHub App -> relay). When set, POST /api/github/webhook
# verifies the X-Hub-Signature-256 HMAC over the raw body and relays comments and
# close/reopen events for bot-filed issues back to the Telegram chat that filed them.
# This is the same "Webhook secret" you set on the App registration form. Unset =
# deliveries are ignored (the endpoint still answers 200).
# GITHUB_WEBHOOK_SECRET=a-long-random-string

# Discord Activity & Interactions (Phase 2 — requires `pip install PyNaCl`)
# DISCORD_CLIENT_ID=your_discord_app_client_id
# DISCORD_CLIENT_SECRET=your_discord_app_client_secret
# DISCORD_REDIRECT_URI=https://tinyfrens.lol/web/
# DISCORD_PUBLIC_KEY=your_app_public_key_from_dev_portal

# Web push notifications for the PWA (Settings → Notifications). Generate a key pair once
# with Node and keep the private key secret; VAPID_PUBLIC_KEY is served to clients:
#   node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();console.log(e.getPublicKey().toString('base64url'));console.log(e.getPrivateKey().toString('base64url'))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:Tinyfrens@agentmail.to



# Robots v1 companion ownership uses Base MAINNET independently of the legacy economy RPC.
# ROBOTS_RPC_URL=https://base-rpc.publicnode.com

# Robots v1 care layer (see docs/robots-care.md). Each pet gets a free daily
# allowance of care actions; beyond it each action costs FRENS and is charged from the credit
# ledger (P4). The admin page (P3) overrides these live.
# ROBOT_CARE_DAILY_ALLOWANCE=24
# ROBOT_CARE_GAME_REWARD_CREDITS=0   # small credit earn-back per finished game round; 0 = off
# ROBOT_CARE_PRICE_FEED=1000
# ROBOT_CARE_PRICE_PLAY=1500
# ROBOT_CARE_PRICE_REST=500
# ROBOT_CARE_PRICE_ADVENTURE=1500
# ROBOT_CARE_PRICE_CLEAN=500
# ROBOT_CARE_PRICE_VITAMIN=5000
# ROBOT_CARE_PRICE_SCOLD=250
# ROBOT_CARE_PRICE_REVIVE=100000

# Robots v1 deposit path (P4, see docs/robots-care.md §6.2). Players send FRENS straight to a
# fixed Dev wallet; the indexer watches ERC-20 Transfer logs to that address and credits the ledger.
# The address is env-only with NO default and the indexer is OFF unless FRENS_TREASURY_INDEXER=true,
# so nothing is ever redirected by a stale config. Rehearse read-only against Base mainnet first.
# FRENS_TREASURY=0x...                         # fixed Dev wallet that receives FRENS
# FRENS_TREASURY_INDEXER=true                  # explicit opt-in to run the treasury indexer
# FRENS_TREASURY_MAX_CREDITS=50000             # per-transfer cap (credits); omit for no cap
# FRENS_TREASURY_CHAIN_ID=8453                 # Base mainnet
# FRENS_TREASURY_TOKEN=0x1A96226727a1D0a46334b3A4b3878B32B7659ba3   # FRENS; defaults to the production token

# Non-public admin surface (see docs/robots-care.md §8 and server/README.md).
# Without ADMIN_TOKEN the whole /api/admin/* surface answers 503, so nothing is exposed.
# The token is a shared secret: generate a long random string and keep it out of git.
# ADMIN_TOKEN=
