PET_DOMAIN=pets.example.com

# Economy (testnet first). Production FRENS: 0x1A96226727a1D0a46334b3A4b3878B32B7659ba3 on Base — see contracts/config/economy.json
# ECONOMY_MODE=testnet
# FRENS_TOKEN=0xDeployTestFRENSOnBaseSepoliaFirst
# CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# ECONOMY_DEPOSITS=false
# UUPS proxies from contracts/testnet/script/DeployEconomy.s.sol
# TREASURY_PROXY=0x...
# JACKPOT_VAULT_PROXY=0x...
# GAME_CONTROLLER=0x...
# DepositRouter proxy + DepositSession clones (also emitted by DeployEconomy.s.sol)
# DEPOSIT_ROUTER_PROXY=0x...
# Controller key that signs DepositRouter.createSession (same wallet used for DeployEconomy on testnet).
# When set (with DEPOSIT_ROUTER_PROXY + BASE_RPC_URL) the server auto-provisions a fresh clone per deposit.
# GAME_CONTROLLER_PRIVATE_KEY=0x...
# Comma-separated deposit-session addresses handed out to users (fallback when no live router; open = no active session)
# DEPOSIT_SESSION_ADDRESSES=0x...,0x...
# Shared secret the deposit indexer sends as X-Indexer-Secret to POST /api/deposits/confirm
# ECONOMY_INDEXER_SECRET=change-me
# On-chain deposit indexer (background task that scans Deposit logs and credits the ledger).
# auto = start whenever an allocator + BASE_RPC_URL are wired; true forces it; false disables.
# INDEXER_ENABLED=auto
# INDEXER_POLL_SECONDS=6
# INDEXER_LOOKBACK=300  # blocks behind head to re-scan on a cold start

# TinyFrens NFT collection (contracts/TinyFrensNFT.sol). 100% on-chain art; address comes from
# contracts/testnet/script/DeployTinyFrensNFT.s.sol. When set (with BASE_RPC_URL) this enables
# GET /api/nft/uri?tokenId=N (on-chain tokenURI) and the web/gallery.html viewer.
# TINYFRENS_NFT_ADDRESS=0x...

# Farcaster Mini App & Neynar Bot Agent
# NEYNAR_API_KEY=your_neynar_api_key
# NEYNAR_CLIENT_ID=your_neynar_client_id
# FARCASTER_SIGNER_UUID=your_approved_signer_uuid
# SNAPCHAIN_API_URL=https://snapchain-api.neynar.com
# NEYNAR_WEBHOOK_URL=https://api.neynar.com/f/app/<client-id>/event

# Telegram Mini App & Bot (see TELEGRAM-DISCORD.md)
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather
# TELEGRAM_MINIAPP_URL=https://tinyfrens.lol/web/
# After deploy, register the webhook once:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-server>/api/telegram/webhook

# Discord Activity & Interactions (Phase 2 — requires `pip install PyNaCl`)
# DISCORD_CLIENT_ID=your_discord_app_client_id
# DISCORD_CLIENT_SECRET=your_discord_app_client_secret
# DISCORD_REDIRECT_URI=https://tinyfrens.lol/web/
# DISCORD_PUBLIC_KEY=your_app_public_key_from_dev_portal


