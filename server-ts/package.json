{
  "name": "tinyfrens-server",
  "version": "1.0.0",
  "description": "TinyFrens TypeScript server",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "indexer": "node dist/indexer-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.2",
    "pngjs": "^7.0.0",
    "viem": "^2.57.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@types/xmldom": "^0.1.34",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
