{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "headers": [
    {
      "source": "/.well-known/farcaster.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/snap-v2.json",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.farcaster.snap+json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "<https://www.tinyfrens.lol/snap>; rel=\"alternate\"; type=\"application/vnd.farcaster.snap+json\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept, X-Snap-Payload" },
        { "key": "Vary", "value": "Accept" },
        { "key": "Link", "value": "<https://www.tinyfrens.lol/snap>; rel=\"alternate\"; type=\"application/vnd.farcaster.snap+json\"" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*application/vnd\\.farcaster\\.snap\\+json.*"
        }
      ],
      "destination": "https://tinyfrens.miono.live/api/snap"
    },
    {
      "source": "/snap",
      "destination": "https://tinyfrens.miono.live/api/snap"
    },
    {
      "source": "/api/snap",
      "destination": "https://tinyfrens.miono.live/api/snap"
    },
    {
      "source": "/api/snap/:path*",
      "destination": "https://tinyfrens.miono.live/api/snap/:path*"
    }
  ]
}
