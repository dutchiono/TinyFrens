[Unit]
Description=TinyFrens Discord Gateway bot
After=network-online.target tinyfrens-server-ts.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/miono/tinyfrens-ts-stage/current/server-ts
EnvironmentFile=/home/miono/tinyfrens-server/.env
EnvironmentFile=/home/miono/tinyfrens-ts-stage/current-revision.env
Environment=NODE_ENV=production
Environment=DB_PATH=/home/miono/tinyfrens-server/tinyfrens.db
ExecStart=/home/miono/tinyfrens-ts-stage/toolchain/bin/node dist/discord-main.js
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
