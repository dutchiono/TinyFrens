[Unit]
Description=TinyFrens TypeScript backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/miono/tinyfrens-ts-stage/current/server-ts
EnvironmentFile=/home/miono/tinyfrens-server/.env
EnvironmentFile=/home/miono/tinyfrens-ts-stage/current-revision.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=DB_PATH=/home/miono/tinyfrens-server/tinyfrens.db
ExecStart=/home/miono/tinyfrens-ts-stage/toolchain/bin/node dist/main.js
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
